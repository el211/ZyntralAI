# ============ Zyntral AI — environment template ============
# Copy to .env and fill in. Never commit real secrets.

# --- Core ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/zyntral
DB_USER=zyntral
DB_PASSWORD=zyntral
DB_POOL_MAX=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (generate a 256-bit base64 secret for prod) ---
JWT_SECRET=change-me-in-prod-use-a-256-bit-secret-value-here!!
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# --- CORS / frontend ---
# Origin(s) the browser app is served from. Comma-separated for multiple.
# Dev: http://localhost:3000   Prod: https://zyntralai.com
CORS_ORIGINS=http://localhost:3000

# Public base URL of the web app. Used to build links in emails
# (verify-email, password reset, invitations) and social-connect redirects.
# Dev: http://localhost:3000   Prod: https://zyntralai.com
WEB_URL=http://localhost:3000

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Social OAuth ---
# Backend public base (where providers redirect the OAuth callback)
SOCIAL_REDIRECT_BASE_URL=http://localhost:8080
# Register each provider's redirect URL as:
#   ${SOCIAL_REDIRECT_BASE_URL}/api/v1/social/oauth/callback/<platform>
# where <platform> is one of: linkedin twitter facebook instagram tiktok youtube pinterest
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Mail (MailHog locally) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
